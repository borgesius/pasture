# --- Sign in with GitHub (an OAuth App: https://github.com/settings/developers) ---
# Callback URL for the OAuth App: https://<your-host>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Any long random string. `openssl rand -base64 32`
AUTH_SECRET=

# The organization the field opens on when someone signs in (they can switch).
PASTURE_DEFAULT_ORG=coval-ai

# --- Self-hosted single-team mode (no sign-in at all) ---
# Give the server one token and everyone who can reach the page sees that token's view.
# GITHUB_TOKEN=ghp_...
# Local development only: read the token from the gh CLI at runtime instead of storing it.
# PASTURE_GH_CLI=1

# Optional: Datadog. Monitors in alert become wolves on the home organization's field.
# An API key and an application key with monitors_read; DD_MONITOR_QUERY narrows what counts (default status:alert).
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com
# DD_MONITOR_QUERY=status:alert tag:team:pipeline
